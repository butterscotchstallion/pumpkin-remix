# Server-only. Never prefix secrets with VITE_.
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2
PORT=5173
# Shared limit per server process (failed/cancelled provider attempts count too).
MAX_GENERATIONS_PER_HOUR=12

# Shared daily observed input + output tokens, resetting at midnight UTC.
# Stops subsequent calls; one image request can overshoot. 0 disables the token threshold.
GENERATION_MAX_DAILY_TOKENS=60000
# Keep this file on a persistent volume if the app is containerized. One server instance only.
GENERATION_USAGE_FILE=.data/generation-usage.json
